<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EmqxMonitor</RootNamespace>
    <AssemblyName>fmo-audit-service</AssemblyName>
    <Version>2.0.17</Version>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <!-- SDK 默认只排除 bin\Debug/obj\Debug; 若不排除 bin\obj\publish\dist,
         默认项 glob(**/*) 会递归遍历发布产物嵌套目录, 导致评估阶段 FileMatcher 无限递归卡死 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**;publish/**;dist/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- Windows 健康采集（PerformanceCounter）；Linux 发布 RID 时不带 -->
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.0"
                      Condition="'$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'win-x86' or '$(RuntimeIdentifier)' == 'win-arm64'" />
  </ItemGroup>

  <ItemGroup>
    <!-- 静态文件嵌入程序集：单文件发布后不依赖外部 wwwroot 目录 -->
    <EmbeddedResource Include="wwwroot/**" />
  </ItemGroup>

</Project>
