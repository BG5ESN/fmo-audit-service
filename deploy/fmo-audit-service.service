[Unit]
Description=FMO Audit Service (审计监控)
After=network.target

[Service]
Type=simple
# 专用低权限用户运行（db 含 EMQX Secret/ingest token，禁止 root）
User=emqx-monitor
Group=emqx-monitor
# 二进制与 db 目录（按实际部署路径修改）
ExecStart=/opt/emqx-monitor/fmo-audit-service
WorkingDirectory=/opt/emqx-monitor
Environment=EMQX_MONITOR_PORT=9527
Environment=EMQX_MONITOR_DB=/opt/emqx-monitor/fmo-audit-service.db
# on-failure：配置错误时不无限重启
Restart=on-failure
RestartSec=5

# 安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
